        "paperAnchorDockedRight": { "host": "paper", "selector": "&.MuiDrawer-paperAnchorDockedRight" },
        "paperAnchorDockedTop": { "host": "paper", "selector": "&.MuiDrawer-paperAnchorDockedTop" },
        "paperAnchorDockedBottom": { "host": "paper", "selector": "&.MuiDrawer-paperAnchorDockedBottom" }
      }
    },
